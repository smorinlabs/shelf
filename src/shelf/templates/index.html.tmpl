<!doctype html>
<html lang="en">
<head>
<!-- __SHELF_FINGERPRINT__ -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>Shelf UI · round 2 — workbench × reading-room × ⌘K</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Spline+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  --paper: #efe9de; --card: #fbf8f2; --card2: #f6f1e8; --ink: #2a2420; --dim: #7d7462;
  --faint: #a49a86; --line: #ddd4c3; --line2: #e7dfd1;
  --ox: #7b2d26; --ox-soft: #f0e2df; --ox-line: #e2c9c4; --gold: #9c7b39;
  --sans: "Spline Sans", system-ui, sans-serif;
  --serif: "Fraunces", Georgia, serif;
  --mono: "JetBrains Mono", ui-monospace, monospace;
  --side: 236px; --prev: 400px;
  color-scheme: light;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; }
body { font-family: var(--sans); background: var(--paper); color: var(--ink); font-size: 14px; -webkit-font-smoothing: antialiased; }
button { font: inherit; cursor: pointer; border: none; background: none; color: inherit; }
input { font: inherit; }
:focus-visible { outline: 2px solid var(--ox); outline-offset: 1px; border-radius: 4px; }
::selection { background: var(--ox-soft); }

/* ---------------- app shell ---------------- */
.app { display: grid; grid-template-rows: auto 1fr; height: 100dvh; }

.topbar {
  display: flex; align-items: center; gap: 16px; padding: 11px 18px;
  background: var(--card); border-bottom: 1px solid var(--line);
}
.brand { font-family: var(--serif); font-size: 21px; font-weight: 600; letter-spacing: -.01em; }
.brand em { color: var(--ox); font-style: italic; }
.reopen { display: none; width: 32px; height: 32px; border-radius: 8px; align-items: center; justify-content: center; color: var(--dim); }
.reopen:hover { background: var(--paper); color: var(--ink); }
.app[data-side="closed"] .reopen { display: inline-flex; }
.prevopen { display: none; width: 32px; height: 32px; border-radius: 8px; align-items: center; justify-content: center; color: var(--dim); }
.prevopen:hover { background: var(--paper); color: var(--ox); }
.prevopen svg { width: 17px; height: 17px; }
.app[data-prev="closed"] .prevopen { display: inline-flex; }

.kbar {
  margin: 0 auto; width: min(440px, 42vw);
  display: flex; align-items: center; gap: 10px;
  background: var(--paper); border: 1px solid var(--line); border-radius: 10px;
  padding: 8px 12px; color: var(--dim); cursor: text; transition: border-color .15s;
}
.kbar:hover { border-color: var(--gold); }
.kbar svg { width: 15px; height: 15px; flex: none; }
.kbar .txt { flex: 1; font-size: 13px; }
.kbar .kk { font-family: var(--mono); font-size: 11px; border: 1px solid var(--line); border-radius: 5px; padding: 2px 6px; background: var(--card); }
.mode { display: flex; align-items: center; gap: 7px; font-size: 12px; color: var(--dim); white-space: nowrap; }
.mode .dot { width: 7px; height: 7px; border-radius: 50%; background: #6f9e5f; box-shadow: 0 0 0 3px rgba(111,158,95,.18); }

/* ---------------- body 3-pane ---------------- */
.body {
  display: grid; grid-template-columns: var(--side) minmax(0, 1fr) var(--prev);
  overflow: hidden; transition: grid-template-columns .24s cubic-bezier(.4,0,.2,1);
}
.app[data-side="closed"] .body { grid-template-columns: 0 minmax(0, 1fr) var(--prev); }
.app[data-prev="closed"] .body { grid-template-columns: var(--side) minmax(0, 1fr) 0; }
.app[data-side="closed"][data-prev="closed"] .body { grid-template-columns: 0 minmax(0, 1fr) 0; }

/* ---------------- sidebar ---------------- */
.side { border-right: 1px solid var(--line); background: var(--card); overflow: hidden auto; display: flex; flex-direction: column; }
.side-inner { width: var(--side); padding: 16px 12px; display: flex; flex-direction: column; gap: 14px; min-height: 100%; }
.side-head { display: flex; align-items: center; justify-content: space-between; }
.side-head .lbl { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; color: var(--faint); }
.collapse { width: 26px; height: 26px; border-radius: 7px; display: grid; place-items: center; color: var(--dim); font-size: 15px; }
.collapse:hover { background: var(--paper); color: var(--ox); }
.viewseg { display: flex; background: var(--ox-soft); border-radius: 9px; padding: 3px; gap: 2px; }
.viewseg button { flex: 1; padding: 6px 0; border-radius: 6px; font-size: 12.5px; font-weight: 500; color: var(--ox); }
.viewseg button.on { background: var(--card); box-shadow: 0 1px 2px rgba(90,40,30,.12); }
.tree { display: flex; flex-direction: column; gap: 1px; }
.tree .all { display: flex; align-items: center; justify-content: space-between; padding: 7px 9px; border-radius: 7px; font-size: 13.5px; font-weight: 500; cursor: pointer; }
.tree .all.on { background: var(--ox-soft); color: var(--ox); }
.tree .cat { font-size: 10.5px; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; color: var(--gold); margin: 12px 0 3px; padding: 0 9px; }
.tree .item { display: flex; align-items: center; justify-content: space-between; padding: 6px 9px; border-radius: 7px; font-size: 13.5px; cursor: pointer; }
.tree .item:hover { background: var(--paper); }
.tree .item.on { background: var(--ox-soft); color: var(--ox); font-weight: 500; }
.tree .item .n { font-family: var(--mono); font-size: 11px; color: var(--faint); }
.side-foot { margin-top: auto; padding-top: 12px; border-top: 1px solid var(--line2); font-family: var(--mono); font-size: 10.5px; color: var(--faint); line-height: 1.8; }
.side-foot b { color: var(--gold); font-weight: 500; }

/* ---------------- list (dense, workbench) ---------------- */
.list { overflow: hidden auto; border-right: 1px solid var(--line); }
.list-head { position: sticky; top: 0; z-index: 3; background: var(--paper); border-bottom: 1px solid var(--line); padding: 9px 18px; display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--dim); }
.list-head .now { font-weight: 500; color: var(--ink); }
.list-head .ct { margin-left: auto; font-family: var(--mono); font-size: 11px; }
.grp { position: sticky; top: 37px; z-index: 2; background: var(--paper); padding: 9px 18px 6px; display: flex; align-items: baseline; gap: 8px; }
.grp .g { font-family: var(--serif); font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: .09em; color: var(--ox); }
.grp .s { font-family: var(--mono); font-size: 11px; color: var(--gold); background: rgba(156,123,57,.1); padding: 1px 7px; border-radius: 5px; }
.grp .rule { flex: 1; height: 1px; background: var(--ox-line); align-self: center; }

.row { display: grid; grid-template-columns: 1fr auto; gap: 3px 14px; padding: 10px 18px; border-bottom: 1px solid var(--line2); cursor: pointer; border-left: 3px solid transparent; transition: background .12s; }
.row:hover { background: var(--card2); }
.row.sel { background: var(--card); border-left-color: var(--ox); }
.row .l { min-width: 0; display: flex; flex-direction: column; gap: 4px; }
.row .tl { display: flex; align-items: center; gap: 9px; }
.row .title { font-family: var(--serif); font-size: 15px; font-weight: 500; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.row .meta { display: flex; align-items: center; gap: 8px; font-size: 11.5px; color: var(--dim); min-width: 0; }
.row .meta .id { font-family: var(--mono); font-size: 10.5px; color: var(--faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.row .meta .tags { white-space: nowrap; }
.row .r { display: flex; align-items: center; gap: 9px; }
.fmts { display: flex; gap: 4px; }
.fmts .f { font-family: var(--mono); font-size: 10px; font-weight: 500; border: 1px solid var(--line); border-radius: 5px; padding: 2px 6px; color: var(--dim); }
.fmts .f.primary { border-color: var(--ox); color: var(--ox); background: var(--ox-soft); }
.kind { font-family: var(--mono); font-size: 10px; padding: 1px 6px; border-radius: 4px; font-weight: 500; white-space: nowrap; }
.k-spec { background: #f0e0dc; color: #8a3a2e; }
.k-reference { background: #dfe6ea; color: #3d5a6c; }
.k-explainer { background: #e2ebdd; color: #4d6b45; }
.k-tutorial { background: #e0e9e8; color: #3f6360; }
.k-playbook { background: #e8e1ec; color: #63496f; }
.k-cheatsheet { background: #efe7d8; color: #7a6230; }

/* ---------------- preview pane ---------------- */
.prev { background: var(--card); overflow: hidden auto; }
.prev-inner { width: var(--prev); padding: 22px 22px 40px; display: flex; flex-direction: column; gap: 16px; }
.prev-top { display: flex; flex-direction: column; gap: 10px; }
.prev-krow { display: flex; align-items: center; gap: 8px; }
.prev-anchor { font-family: var(--mono); font-size: 11px; color: var(--gold); }
.prev-close { margin-left: auto; width: 26px; height: 26px; border-radius: 7px; display: grid; place-items: center; color: var(--faint); }
.prev-close:hover { background: var(--paper); color: var(--ink); }
.prev-title { font-family: var(--serif); font-size: 22px; font-weight: 600; line-height: 1.18; text-wrap: balance; }
.prev-id { font-family: var(--mono); font-size: 11px; color: var(--faint); word-break: break-all; }
.prev-tags { display: flex; flex-wrap: wrap; gap: 6px; }
.prev-tags span { font-size: 11.5px; background: var(--paper); border: 1px solid var(--line); padding: 2px 8px; border-radius: 999px; color: var(--dim); }

.prev-actions { display: flex; flex-direction: column; gap: 6px; }
.pa-row { display: flex; align-items: center; gap: 8px; }
.pa-row .pf { font-family: var(--mono); font-size: 10.5px; color: var(--dim); width: 40px; }
.pa-row .pf b { color: var(--ox); }
.pa-btn { font-size: 12px; border: 1px solid var(--line); background: var(--paper); border-radius: 7px; padding: 5px 11px; color: var(--ink); transition: border-color .15s, color .15s; }
.pa-btn:hover { border-color: var(--ox); color: var(--ox); }
.pa-btn.text { border-style: dashed; }
.pa-btn[disabled] { opacity: .4; cursor: not-allowed; }

.snip-lbl { font-size: 10.5px; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; color: var(--faint); display: flex; align-items: center; gap: 8px; }
.snip-lbl .rule { flex: 1; height: 1px; background: var(--line); }
.snip { position: relative; background: var(--card2); border: 1px solid var(--line2); border-radius: 11px; padding: 16px 17px 26px; }
.snip::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 42px; border-radius: 0 0 11px 11px; background: linear-gradient(transparent, var(--card2)); }
.snip h1 { font-family: var(--serif); font-size: 17px; font-weight: 600; margin-bottom: 9px; line-height: 1.25; }
.snip h3 { font-family: var(--serif); font-size: 13.5px; font-weight: 600; margin: 12px 0 6px; color: var(--ox); }
.snip p { font-size: 13px; line-height: 1.55; color: var(--ink); margin-bottom: 8px; }
.snip ul { margin: 4px 0 8px; display: flex; flex-direction: column; gap: 4px; }
.snip li { font-size: 12.5px; line-height: 1.45; color: var(--ink); padding-left: 16px; position: relative; }
.snip li::before { content: "–"; position: absolute; left: 2px; color: var(--ox); }
.snip pre { font-family: var(--mono); font-size: 11.5px; line-height: 1.5; background: var(--paper); border: 1px solid var(--line); border-radius: 7px; padding: 9px 11px; overflow-x: auto; color: var(--ink); margin: 4px 0 8px; }
.snip code { font-family: var(--mono); }
.snip-hint { font-size: 11px; color: var(--faint); text-align: center; }
.snip-hint b { color: var(--ox); font-weight: 500; }

.prev-empty { padding: 60px 24px; text-align: center; color: var(--faint); }
.prev-empty .big { font-family: var(--serif); font-size: 18px; color: var(--dim); margin-bottom: 6px; }

/* ---------------- ⌘K palette ---------------- */
.scrim { position: fixed; inset: 0; background: rgba(42,36,32,.42); backdrop-filter: blur(2px); display: none; z-index: 100; align-items: flex-start; justify-content: center; padding-top: 12vh; }
.scrim.open { display: flex; }
.palette { width: min(620px, 92vw); background: var(--card); border: 1px solid var(--line); border-radius: 15px; box-shadow: 0 30px 70px rgba(42,24,18,.34); overflow: hidden; }
.pal-in { display: flex; align-items: center; gap: 12px; padding: 16px 18px; border-bottom: 1px solid var(--line2); }
.pal-in .pr { font-family: var(--mono); color: var(--ox); font-size: 18px; }
.pal-in input { flex: 1; border: none; background: none; font-family: var(--mono); font-size: 17px; color: var(--ink); }
.pal-in input::placeholder { color: var(--faint); }
.pal-in .esc { font-family: var(--mono); font-size: 11px; color: var(--faint); border: 1px solid var(--line); border-radius: 5px; padding: 3px 7px; }
.pal-results { max-height: 46vh; overflow: auto; padding: 7px; }
.pal-grp { font-family: var(--mono); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--faint); padding: 10px 11px 5px; }
.pal-grp b { color: var(--gold); text-transform: none; letter-spacing: 0; }
.pal-item { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 3px 12px; padding: 9px 12px; border-radius: 9px; cursor: pointer; }
.pal-item .pl { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.pal-item .ptl { display: flex; align-items: center; gap: 9px; }
.pal-item .ptt { font-family: var(--serif); font-size: 14.5px; font-weight: 500; }
.pal-item .pd { font-size: 12px; color: var(--dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pal-item.sel { background: var(--ox-soft); }
.pal-item.sel .ptt { color: var(--ox); }
.pal-item .pr2 { display: flex; align-items: center; gap: 10px; font-family: var(--mono); font-size: 11px; color: var(--dim); }
.pal-item .ent { color: var(--ox); opacity: 0; }
.pal-item.sel .ent { opacity: 1; }
.pal-none { padding: 26px; text-align: center; color: var(--faint); font-size: 13px; }
.pal-foot { display: flex; gap: 16px; padding: 10px 16px; border-top: 1px solid var(--line2); font-family: var(--mono); font-size: 11px; color: var(--faint); }
.pal-foot b { color: var(--ink); font-weight: 500; }

/* toast */
.toast { position: fixed; bottom: 26px; left: 50%; transform: translateX(-50%) translateY(14px); background: var(--ink); color: var(--card); font-size: 12.5px; padding: 9px 15px; border-radius: 9px; box-shadow: 0 10px 30px rgba(0,0,0,.28); opacity: 0; pointer-events: none; transition: opacity .18s, transform .18s; z-index: 200; display: flex; align-items: center; gap: 9px; }
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
.toast .tick { color: #a7cf96; }
.toast .p { font-family: var(--mono); font-size: 11.5px; color: #d8cdb8; }

@media (max-width: 1080px) { :root { --prev: 0px; } .app[data-prev] .body { grid-template-columns: var(--side) 1fr 0 !important; } }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
</head>
<body>
<div class="app" id="app" data-side="open" data-prev="open">

  <div class="topbar">
    <button class="reopen" id="reopen" title="Show sidebar">☰</button>
    <div class="brand">sh<em>e</em>lf</div>
    <div class="kbar" id="kopen">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
      <span class="txt">Search titles, descriptions, tags…</span>
      <span class="kk">⌘K</span>
    </div>
    <div class="mode"><span class="dot"></span> Enhanced · copy text on</div>
    <button class="prevopen" id="prevopen" title="Show preview ( ] )">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="15" y1="4" x2="15" y2="20"/></svg>
    </button>
  </div>

  <div class="body">
    <aside class="side">
      <div class="side-inner">
        <div class="side-head">
          <span class="lbl">Library</span>
          <button class="collapse" id="collapse" title="Collapse sidebar">«</button>
        </div>
        <div class="viewseg" id="viewseg">
          <button class="on" data-v="subject">Subject</button>
          <button data-v="kind">Kind</button>
        </div>
        <div class="tree" id="tree"></div>
        <div class="side-foot" id="sidefoot"></div>
      </div>
    </aside>

    <section class="list">
      <div class="list-head">
        <span>Grouped by <span class="now" id="nowview">subject</span></span>
        <span class="ct" id="listct"></span>
      </div>
      <div id="listbody"></div>
    </section>

    <aside class="prev" id="prev"></aside>
  </div>
</div>

<!-- ⌘K palette -->
<div class="scrim" id="scrim">
  <div class="palette" role="dialog" aria-label="Search">
    <div class="pal-in">
      <span class="pr">›</span>
      <input id="palinput" placeholder="Search your library…" autocomplete="off" spellcheck="false">
      <span class="esc">esc</span>
    </div>
    <div class="pal-results" id="palresults"></div>
    <div class="pal-foot"><span><b>↑↓</b> move</span><span><b>⏎</b> copy path</span><span><b>⌥⏎</b> copy text</span><span><b>esc</b> close</span></div>
  </div>
</div>

<div class="toast" id="toast"><span class="tick">✓</span><span>Copied path</span><span class="p" id="toastpath"></span></div>

<script>
/* ---------------- data ---------------- */
const ENHANCED = location.protocol !== "file:";
const PAGE = __SHELF_DATA__;
const ROOT = PAGE.root;
const DOCS = PAGE.docs;
const REPO_ORDER = [...new Set(DOCS.filter(d=>d.anchor.type==="repo").map(d=>d.anchor.group))];
const TOPIC_ORDER = PAGE.topics;
const KIND_ORDER = PAGE.kinds;

function relPath(d, fmt){ const a=d.anchor; const base=a.type==="repo"?`docs/repos/${a.group}`:`docs/topics/${a.group}`; return `${base}/${d.id}/${d.id}.${fmt}`; }
const FILE_ROOT = decodeURIComponent(location.pathname.replace(/\/index\.html$/, ""));
function absPath(d, fmt){ return `${ENHANCED ? ROOT : FILE_ROOT}/${relPath(d, fmt)}`; }
function primary(d){ return d.formats.find(x=>x.primary)||d.formats[0]; }

/* ---------------- state ---------------- */
let view = "subject";       // subject | kind
let filter = null;          // null | {group} | {kind}
let sel = 0;                // index into visible rows
let visRows = [];           // [{doc, el}]

/* ---------------- copy helpers ---------------- */
const toast = document.getElementById("toast");
const toastpath = document.getElementById("toastpath");
let toastT;
function copy(text, label){
  try { navigator.clipboard && navigator.clipboard.writeText(text); } catch(e){}
  toastpath.textContent = text.length>52 ? "…"+text.slice(-50) : text;
  toast.querySelector("span:nth-child(2)").textContent = label||"Copied path";
  toast.classList.add("show"); clearTimeout(toastT);
  toastT = setTimeout(()=>toast.classList.remove("show"), 1400);
}

/* ---------------- sidebar ---------------- */
function renderSidebar(){
  const tree = document.getElementById("tree");
  const counts = {};
  DOCS.forEach(d=>{ const g=d.anchor.group; counts[g]=(counts[g]||0)+1; });
  const kcounts = {}; DOCS.forEach(d=> kcounts[d.kind]=(kcounts[d.kind]||0)+1);
  let h = `<div class="all ${filter===null?'on':''}" data-all="1">All documents <span class="n">${DOCS.length}</span></div>`;
  if(view==="subject"){
    h += `<div class="cat">Repos</div>`;
    REPO_ORDER.forEach(g=> h+=`<div class="item ${filter&&filter.group===g?'on':''}" data-group="${g}">${g} <span class="n">${counts[g]||0}</span></div>`);
    h += `<div class="cat">Topics</div>`;
    TOPIC_ORDER.forEach(g=> h+=`<div class="item ${filter&&filter.group===g?'on':''}" data-group="${g}">${g} <span class="n">${counts[g]||0}</span></div>`);
  } else {
    h += `<div class="cat">Kinds</div>`;
    KIND_ORDER.forEach(k=> h+=`<div class="item ${filter&&filter.kind===k?'on':''}" data-kind="${k}">${k} <span class="n">${kcounts[k]||0}</span></div>`);
  }
  tree.innerHTML = h;
  tree.querySelectorAll("[data-group],[data-kind],[data-all]").forEach(el=>{
    el.addEventListener("click", ()=>{
      if(el.dataset.all) filter=null;
      else if(el.dataset.group) filter={group:el.dataset.group};
      else filter={kind:el.dataset.kind};
      sel=0; renderSidebar(); renderList();
    });
  });
  document.getElementById("sidefoot").innerHTML = `__SHELF_DOC_COUNT__ docs · 13 files<br><b>${ENHANCED ? "enhanced" : "core"}</b> · ${ENHANCED ? "localhost:8765" : "file"}<br>${ENHANCED ? ROOT : FILE_ROOT}`;
}

/* ---------------- list ---------------- */
function visibleDocs(){
  let ds = DOCS.slice();
  if(filter && filter.group) ds = ds.filter(d=>d.anchor.group===filter.group);
  if(filter && filter.kind) ds = ds.filter(d=>d.kind===filter.kind);
  return ds;
}
function groupsFor(ds){
  const groups = [];
  if(view==="subject"){
    REPO_ORDER.forEach(g=>{ const items=ds.filter(d=>d.anchor.type==="repo"&&d.anchor.group===g); if(items.length){ const subj=items[0].anchor.subject; groups.push({label:g, sub:subj, items}); }});
    TOPIC_ORDER.forEach(g=>{ const items=ds.filter(d=>d.anchor.type==="topic"&&d.anchor.group===g); if(items.length) groups.push({label:g, items}); });
  } else {
    KIND_ORDER.forEach(k=>{ const items=ds.filter(d=>d.kind===k); if(items.length) groups.push({label:k, items}); });
  }
  return groups;
}
function rowHTML(d){
  const fmts = d.formats.map(x=>`<span class="f ${x.primary?'primary':''}">${x.f}</span>`).join("");
  return `<div class="l">
      <div class="tl"><span class="title">${d.title}</span><span class="kind k-${d.kind}">${d.kind}</span></div>
      <div class="meta"><span class="id">${d.id}</span><span class="tags">${d.tags.join(" · ")}</span></div>
    </div>
    <div class="r"><div class="fmts">${fmts}</div></div>`;
}
function renderList(){
  const body = document.getElementById("listbody");
  const ds = visibleDocs();
  const groups = groupsFor(ds);
  document.getElementById("nowview").textContent = view;
  document.getElementById("listct").textContent = ds.length + " / " + DOCS.length;
  body.innerHTML = "";
  visRows = [];
  groups.forEach(g=>{
    const gh = document.createElement("div"); gh.className="grp";
    gh.innerHTML = `<span class="g">${g.label}</span>${g.sub?`<span class="s">${g.sub}</span>`:""}<span class="rule"></span>`;
    body.appendChild(gh);
    g.items.forEach(d=>{
      const row = document.createElement("div"); row.className="row"; row.innerHTML=rowHTML(d);
      const idx = visRows.length;
      row.addEventListener("click", ()=>{ sel=idx; paint(); });
      body.appendChild(row);
      visRows.push({doc:d, el:row});
    });
  });
  if(sel>=visRows.length) sel = Math.max(0, visRows.length-1);
  paint();
}
function paint(){
  visRows.forEach((r,i)=> r.el.classList.toggle("sel", i===sel));
  renderPreview(visRows[sel] ? visRows[sel].doc : null);
  if(visRows[sel]) visRows[sel].el.scrollIntoView({block:"nearest"});
}

/* ---------------- preview ---------------- */
function renderPreview(d){
  const prev = document.getElementById("prev");
  if(!d){ prev.innerHTML = `<div class="prev-empty"><div class="big">Nothing selected</div><div>Pick a document to peek inside.</div></div>`; return; }
  const a=d.anchor;
  const anchorLabel = a.type==="repo" ? `${a.group} · ${a.subject}` : a.group;
  const acts = d.formats.map(x=>{
    const p = absPath(d, x.f);
    return `<div class="pa-row"><span class="pf">${x.primary?'<b>':''}${x.f}${x.primary?' ●</b>':''}</span>
      <button class="pa-btn" data-copy="${p}">Copy path</button>
      <button class="pa-btn text" ${ENHANCED&&x.text?`data-copytext="${d.id}.${x.f}"`:'disabled'} ${ENHANCED?'':'hidden'}>Copy text</button></div>`;
  }).join("");
  prev.innerHTML = `<div class="prev-inner">
    <div class="prev-top">
      <div class="prev-krow"><span class="kind k-${d.kind}">${d.kind}</span><span class="prev-anchor">${anchorLabel}</span>
        <button class="prev-close" id="prevclose" title="Hide preview">›</button></div>
      <div class="prev-title">${d.title}</div>
      <div class="prev-id">${relPath(d, primary(d).f)}</div>
      <div class="prev-tags">${d.tags.map(t=>`<span>${t}</span>`).join("")}</div>
    </div>
    <div class="prev-actions">${acts}</div>
    <div class="snip-lbl">Preview <span class="rule"></span> ${primary(d).f}</div>
    <div class="snip">${d.snippet}</div>
    <div class="snip-hint">first lines · <b>copy text</b> or open to read the rest</div>
  </div>`;
  prev.querySelectorAll("[data-copy]").forEach(b=> b.addEventListener("click", e=>{ e.stopPropagation(); copy(b.dataset.copy, "Copied path"); }));
  prev.querySelectorAll("[data-copytext]").forEach(b=> b.addEventListener("click", e=>{ e.stopPropagation(); copy("(contents of "+b.dataset.copytext+")", "Copied text"); }));
  const pc = document.getElementById("prevclose"); if(pc) pc.addEventListener("click", ()=> app.dataset.prev = "closed");
}

/* ---------------- ⌘K palette ---------------- */
const scrim = document.getElementById("scrim");
const palinput = document.getElementById("palinput");
const palresults = document.getElementById("palresults");
let palRows = [], palSel = 0;
function openPalette(){ scrim.classList.add("open"); palinput.value=""; renderPalette(""); palinput.focus(); }
function closePalette(){ scrim.classList.remove("open"); }
function scoreMatch(d, q){ const hay=(d.title+" "+d.tags.join(" ")+" "+d.id+" "+(d.anchor.subject||"")).toLowerCase(); return hay.includes(q); }
function renderPalette(q){
  q = q.trim().toLowerCase();
  const ds = q ? DOCS.filter(d=>scoreMatch(d,q)) : DOCS.slice(0,6);
  palRows = []; palSel = 0;
  if(!ds.length){ palresults.innerHTML = `<div class="pal-none">No documents match “${q}”.</div>`; return; }
  // group by subject for display
  let html = ""; const groups = groupsForList(ds);
  groups.forEach(g=>{
    html += `<div class="pal-grp">${g.label}${g.sub?` <b>· ${g.sub}</b>`:""}</div>`;
    g.items.forEach(d=>{
      const i = palRows.length; palRows.push(d);
      html += `<div class="pal-item" data-i="${i}">
        <div class="pl"><div class="ptl"><span class="ptt">${d.title}</span><span class="kind k-${d.kind}">${d.kind}</span></div>
          <div class="pd">${d.snippet.replace(/<[^>]+>/g," ").replace(/\\s+/g," ").trim().slice(0,64)}…</div></div>
        <div class="pr2"><span>${d.formats.map(x=>x.f).join(" · ")}</span><span class="ent">⏎</span></div></div>`;
    });
  });
  palresults.innerHTML = html;
  palresults.querySelectorAll(".pal-item").forEach(el=>{
    el.addEventListener("click", ()=>{ palSel=+el.dataset.i; paintPalette(); enterPalette(false); });
    el.addEventListener("mousemove", ()=>{ palSel=+el.dataset.i; paintPalette(); });
  });
  paintPalette();
}
function groupsForList(ds){
  const groups=[];
  REPO_ORDER.forEach(g=>{ const items=ds.filter(d=>d.anchor.type==="repo"&&d.anchor.group===g); if(items.length) groups.push({label:g, sub:items[0].anchor.subject, items}); });
  TOPIC_ORDER.forEach(g=>{ const items=ds.filter(d=>d.anchor.type==="topic"&&d.anchor.group===g); if(items.length) groups.push({label:g, items}); });
  return groups;
}
function paintPalette(){ palresults.querySelectorAll(".pal-item").forEach((el,i)=>{ const on=(+el.dataset.i===palSel); el.classList.toggle("sel",on); if(on) el.scrollIntoView({block:"nearest"}); }); }
function enterPalette(text){ const d=palRows[palSel]; if(!d) return; const p=primary(d); if(text){ if(ENHANCED&&p.text) copy("(contents of "+d.id+"."+p.f+")","Copied text"); } else copy(absPath(d,p.f),"Copied path"); closePalette(); }

/* ---------------- events ---------------- */
const app = document.getElementById("app");
document.getElementById("collapse").addEventListener("click", ()=> app.dataset.side="closed");
document.getElementById("reopen").addEventListener("click", ()=> app.dataset.side="open");
document.getElementById("prevopen").addEventListener("click", ()=> app.dataset.prev="open");
document.getElementById("kopen").addEventListener("click", openPalette);
document.getElementById("viewseg").addEventListener("click", e=>{
  const b=e.target.closest("button[data-v]"); if(!b) return;
  document.querySelectorAll("#viewseg button").forEach(x=>x.classList.remove("on")); b.classList.add("on");
  view=b.dataset.v; filter=null; sel=0; renderSidebar(); renderList();
});
scrim.addEventListener("click", e=>{ if(e.target===scrim) closePalette(); });
palinput.addEventListener("input", ()=> renderPalette(palinput.value));

document.addEventListener("keydown", e=>{
  const k = e.key;
  // open palette
  if((e.metaKey||e.ctrlKey) && (k==="k"||k==="K")){ e.preventDefault(); scrim.classList.contains("open")?closePalette():openPalette(); return; }
  if(scrim.classList.contains("open")){
    if(k==="Escape"){ e.preventDefault(); closePalette(); }
    else if(k==="ArrowDown"){ e.preventDefault(); palSel=Math.min(palRows.length-1,palSel+1); paintPalette(); }
    else if(k==="ArrowUp"){ e.preventDefault(); palSel=Math.max(0,palSel-1); paintPalette(); }
    else if(k==="Enter"){ e.preventDefault(); enterPalette(e.altKey); }
    return;
  }
  // main list nav (only when not typing in a field)
  const typing = document.activeElement && (document.activeElement.tagName==="INPUT");
  if(typing) return;
  if(k==="ArrowDown"){ e.preventDefault(); sel=Math.min(visRows.length-1,sel+1); paint(); }
  else if(k==="ArrowUp"){ e.preventDefault(); sel=Math.max(0,sel-1); paint(); }
  else if(k==="Enter" && visRows[sel]){ e.preventDefault(); const d=visRows[sel].doc; const p=primary(d); if(e.altKey&&ENHANCED&&p.text) copy("(contents of "+d.id+"."+p.f+")","Copied text"); else copy(absPath(d,p.f),"Copied path"); }
  else if(k==="["){ app.dataset.side = app.dataset.side==="closed"?"open":"closed"; }
  else if(k==="]"){ app.dataset.prev = app.dataset.prev==="closed"?"open":"closed"; }
});

/* ---------------- init ---------------- */
document.querySelector(".mode").innerHTML = `<span class="dot"></span> ${ENHANCED ? "Enhanced · copy text on" : "Core · copy text off"}`;
renderSidebar(); renderList();
</script>
</body>
</html>
